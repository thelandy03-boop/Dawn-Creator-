{
  "name": "dawn-studio-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Build bundle local del editor CodeMirror 6 de Dawn Studio",
  "scripts": {
    "build": "esbuild codemirror6-entry.js --bundle --format=iife --global-name=DawnCodeMirror6 --target=es2020 --legal-comments=inline --minify --outfile=codemirror6.bundle.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
